# ============================================================
# CDMIIS 环境变量模板
# 使用方法：复制本文件为 .env 并填入真实值
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
# 注意：.env 已加入 .gitignore，绝不提交真实密钥
# ============================================================

# ---------- 大模型 API（必填） ----------
QWEN_API_KEY=your_dashscope_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=qwen-plus
QWEN_VL_MODEL_NAME=qwen-vl-max

# ---------- Neo4j 知识图谱 ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# ---------- Milvus 向量库 ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ---------- RedisStack 短期记忆 ----------
REDIS_URL=redis://localhost:6379/0

# ---------- PostgreSQL 长期记忆 ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cloud_diagnosis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# ---------- 训练监控 ----------
SWANLAB_API_KEY=your_swanlab_api_key_here

# ---------- 诊断收敛参数 ----------
CONFIDENCE_THRESHOLD=0.70
CONFIDENCE_GAP=0.30
MIN_INQUIRY_ROUNDS=3
MAX_INQUIRY_ROUNDS=10

# ---------- 症状标准化权重 ----------
SYMPTOM_GRAPH_WEIGHT=0.5
SYMPTOM_VECTOR_WEIGHT=0.3
SYMPTOM_LLM_WEIGHT=0.2
